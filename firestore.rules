rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Projects collection: case studies and visual stream
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isValidId(projectId);
    }

    // Site configuration collection: hero, about, capabilities, skills, etc.
    match /site_configs/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }

    // Site settings collection: visibility toggles, theme options
    match /site_settings/{settingsId} {
      allow read: if true;
      allow write: if isValidId(settingsId);
    }

    // Uploaded images collection: persistent image assets for case studies and portfolio
    match /uploaded_images/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    // Visitor contact messages collection: allows visitors to submit messages and admin to read/manage
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.message is string;
      allow read, update, delete: if true;
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
