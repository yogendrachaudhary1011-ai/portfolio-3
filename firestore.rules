rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Projects collection: case studies and visual stream
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isValidId(projectId);
    }

    // Site configuration collection: hero, about, capabilities, skills, etc.
    match /site_configs/{configId} {
      allow read: if true;
      allow write: if isValidId(configId);
    }

    // Site settings collection: visibility toggles, theme options
    match /site_settings/{settingsId} {
      allow read: if true;
      allow write: if isValidId(settingsId);
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
